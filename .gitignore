# Ignore everything by default
/*

# Allow git configuration files
!/.gitignore
!/.gitattributes
!/.github/

# Allow the wp-content directory so we can selectively include items within it
!/wp-content/

# Ignore everything in wp-content by default
/wp-content/*

# Allow themes directory
!/wp-content/themes/

# Ignore all themes except our child theme
/wp-content/themes/generatepress/

# Allow plugins directory
!/wp-content/plugins/
!/wp-content/mu-plugins/

# Ignore all plugins except rrhub-directories
/wp-content/plugins/*

# ==================================
# Standard Development Exclusions
# ==================================

# Dependencies
node_modules/
vendor/
bower_components/

# Build artifacts
dist/
build/

# Source maps
*.css.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE and tool config
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace
.phpstorm.meta.php
.editorconfig
.nvmrc
.wp-env.json
.env.sample

# Environment files
.env
.env.local
.env.*.local

# Package manager files
package-lock.json
yarn.lock
composer.lock
composer.json

# Dev-only files
RoboFile.php
BUILD.md
CLAUDE.md

# Source/build directories (compiled output is in assets/)
npm/

# Backup files
*bkup*
*backup*

# Temporary files
*.tmp
*.temp
.cache/
ewart-notes/